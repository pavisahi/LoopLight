    {
      "parameters": {
        "jsCode": "const extraction = $(\"Information Extractor\").first().json.output;\nconst form = $(\"On form submission\").first().json;\nconst submittedAt = form.submittedAt;\n\nif (!submittedAt) {\n  return [{\n    json: {\n      has_new_item: false,\n      session_id: \"unknown\",\n      error: \"Could not read this submission. Nothing was saved — please try submitting again.\"\n    }\n  }];\n}\n\nconst items = Array.isArray(extraction?.items) ? extraction.items : [];\n\nif (items.length === 0) {\n  return [{ json: { has_new_item: false, session_id: submittedAt } }];\n}\n\nreturn items.map((item, index) => ({\n  json: {\n    has_new_item: true,\n    item_id: `${submittedAt}-${index + 1}`,\n    session_id: submittedAt,\n    created_at: submittedAt,\n    source_text: item.source_text ?? \"\",\n    description: item.description ?? \"\",\n    item_type: item.item_type ?? \"concern\",\n    status: item.status ?? \"open\",\n    deadline_text: item.deadline_text ?? \"\",\n    effort_band: item.effort_band ?? \"unknown\",\n    needs_clarification: Boolean(item.needs_clarification)\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        -336
      ],
      "id": "960f81b4-220c-42a1-91ba-f0dda445f4f2",
      "name": "Prepare Items",
      "notes": "const extraction = $items(\"Information Extractor\")[0]?.json?.output ?? {};\nconst form = $items(\"On form submission\")[0]?.json ?? {};\n\nconst submittedAt = form.submittedAt;\n\nif (!submittedAt) {\n  throw new Error(\"Missing submittedAt from the form submission.\");\n}\n\nconst items = Array.isArray(extraction.items) ? extraction.items : [];\n\n// Keep the workflow running for a capacity-only submission.\nif (items.length === 0) {\n  return [\n    {\n      json: {\n        has_new_item: false,\n        session_id: submittedAt\n      }\n    }\n  ];\n}\n\n// Create one n8n record for every extracted item.\nreturn items.map((item, index) => ({\n  json: {\n    has_new_item: true,\n    item_id: `${submittedAt}-${index + 1}`,\n    session_id: submittedAt,\n    created_at: submittedAt,\n    source_text: item.source_text ?? \"\",\n    description: item.description ?? \"\",\n    item_type: item.item_type ?? \"concern\",\n    status: item.status ?? \"open\",\n    deadline_text: item.deadline_text ?? \"\",\n    effort_band: item.effort_band ?? \"unknown\",\n    needs_clarification: Boolean(item.needs_clarification),\n    todoist_task_id: \"\"\n  }\n}));"
    },
